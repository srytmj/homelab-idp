# Server Configuration
PORT=4000
NODE_ENV=production
APP_URL=http://localhost:4000

# Security Secrets
JWT_SECRET=generate_a_random_64_character_string_here_0123456789abcdef0123456789abcdef
VAULT_SECRET_KEY=generate_a_32_byte_hex_or_base64_string_here_32_bytes!
SESSION_TTL_HOURS=720

# Database (PostgreSQL Shared Homelab)
DATABASE_URL=postgres://admin:your_password@postgres:5432/homelab_idp?sslmode=disable

# Initial Admin Seeding (dibuat otomatis jika DB kosong)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_this_master_password
INITIAL_ADMIN_EMAIL=admin@suryatmaja.dev
INITIAL_ADMIN_NAME="Homelab Administrator"
